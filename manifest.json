{
  "manifest_version": 3,
  "name": "Bandcamp Tab Merger",
  "version": "0.1.1",
  "description": "Merge open Bandcamp tabs into one playable grid.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["*://*.bandcamp.com/*", "*://*.bcbits.com/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open Bandcamp Tab Merger",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  }
}
